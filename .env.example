PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
BOOTH_ID=booth-demo-001

# Required for cloud persistence. Use the service role key only in Vercel
# server-side env vars; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Demo owner key. In production each owner/merchant should have their own
# encrypted PayMongo credential or connected payment account.
PAYMONGO_SECRET_KEY=

# Optional. Fill this in after creating a PayMongo webhook endpoint.
PAYMONGO_WEBHOOK_SECRET=
